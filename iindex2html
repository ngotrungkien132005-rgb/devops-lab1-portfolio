                            <label class="quiz-option">
                                <input type="radio" name="q3" value="c"> \ (Gạch chéo ngược)
                            </label>
                        </div>

                        <button id="submitQuizBtn" class="btn btn-primary btn-block" style="margin-top: 20px;">Nộp bài & Xem điểm</button>
